# Production-сборка bb-frontend: Vite build -> статика в nginx.
# Сборка:  docker build -f frontend/Dockerfile.prod --build-arg VITE_API_URL=/api -t bb-frontend:prod-1 frontend
# VITE_API_URL — build-time (Vite вшивает значение в бандл), менять = пересобрать.
# syntax=docker/dockerfile:1

FROM node:24-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
